<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			默认只编译 1.7(net10.0)；需要 1.6(net48) 时：dotnet build -p:IncludeRimWorld16=true
			平时保持单目标，IDE 的分析上下文也就自然是 net10.0
		-->
		<IncludeRimWorld16 Condition="'$(IncludeRimWorld16)' == ''">false</IncludeRimWorld16>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(IncludeRimWorld16)' == 'true'">net10.0;net48</TargetFrameworks>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- 让 dll 直接落到 1.6/Assemblies、1.7/Assemblies，而不是 …/net48/ -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<DebugType>embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<FileVersion></FileVersion>
		<!-- 类库不需要 *.deps.json，避免污染模组 Assemblies 目录 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<!--
		坑位：AppendTargetFrameworkToOutputPath=false 会【同时】去掉中间目录的 TFM 后缀，
		两个目标共用 obj\Release 会在并行编译时互相覆盖（报 "obj\Release\refint\xxx.dll 不存在"）。
		必须为每个 TFM 单独指定 IntermediateOutputPath。
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<IntermediateOutputPath>obj\$(Configuration)\net48\</IntermediateOutputPath>
		<OutputPath>..\..\1.6\Assemblies\</OutputPath>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<IntermediateOutputPath>obj\$(Configuration)\net10.0\</IntermediateOutputPath>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
	</PropertyGroup>

	<!-- 1.7 引用游戏安装目录：可用 -p:RimWorldDir=… 或环境变量 RIMWORLD_DIR 覆盖 -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</RimWorldDir>
	</PropertyGroup>

	<!-- 1.6：Krafs 引用包（锁在 1.6.x，避免 * 浮动到别的大版本） -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Krafs.Rimworld.Ref">
			<Version>1.6.*</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- 1.7：直接引用游戏程序集；Unity 由 UnityStubs 提供，Waylith 是 UnityStubs 的实现层 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Harmony 分 TFM 引用（运行时由游戏/依赖模组提供，不复制到输出） -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Lib.Harmony">
			<Version>2.4.*</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Lib.Harmony">
			<Version>3.0.0-rc.2</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
	<!-- 可选 Mod（PipeSystem / VEF / VanillaPsycastsExpanded）不在此引用：
	     一旦引用，编译器就可能把它们的类型编进类型/闭包字段，未加载该 Mod 的玩家会在
	     启动期 TypeLoadException。这些 Mod 的类型一律按全名反射访问（见 DataUtility）。 -->
</Project>
