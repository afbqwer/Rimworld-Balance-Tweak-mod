<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			1.6 已归档（2026-10）：不再参与编译。
			  · 1.6/Assemblies/BalanceTweak.dll 保留为归档产物，冻结在归档时的状态，不再随源码更新。
			  · 下面标了「1.6（已归档）」的各段仍保留原样（注释状态），确需回流时取消注释，
			    并把 TargetFrameworks 改回 net10.0;net48 即可恢复双目标构建。
			平时只编译 1.7(net10.0)，IDE 的分析上下文也就自然是 net10.0。
		-->
		<TargetFrameworks>net10.0</TargetFrameworks>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- 让 dll 直接落到 1.7/Assemblies，而不是 …/net10.0/ -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<DebugType>embedded</DebugType>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<FileVersion></FileVersion>
		<!-- 类库不需要 *.deps.json，避免污染模组 Assemblies 目录 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<!--
			自检只在显式 -p:SelfCheck=true 时编进去。
			原来是 #if DEBUG：于是随手 build 一次（IDE / slnx 默认 Debug）落进 1.7/Assemblies 的
			就是带自检、会往 Config 写 BalanceTweak_Snapshot_*.txt 的调试版 —— 每次发版还得记得再编一次 Release。
			现在默认关闭，任何配置构建出来的都是公开版行为。
		-->
		<SelfCheck Condition="'$(SelfCheck)' == ''">false</SelfCheck>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SelfCheck)' == 'true'">
		<DefineConstants>$(DefineConstants);BT_SELFCHECK</DefineConstants>
	</PropertyGroup>

	<!--
		模组内的手动测试（整文件包在 #if BT_SELFCHECK 里）只在开启自检时参与编译，
		免得发布产物里留一堆没人调用的死代码。
		TweakSelfCheck.cs 不在此列：TweakDatabase.Init 要调它，必须常驻。
	-->
	<ItemGroup Condition="'$(SelfCheck)' != 'true'">
		<Compile Remove="Tests/TweakDataSerializationTests.cs" />
		<Compile Remove="Tests/TweakFieldScribeRoundTripTests.cs" />
	</ItemGroup>

	<!--
		Debug 与 Release 的产物等价（Debug 也开优化）。
		为什么不是"把默认配置改成 Release"：OutputPath 与配置无关（两者都直接覆盖 1.7/Assemblies/BalanceTweak.dll），
		而解决方案 / IDE 构建会把 Configuration=Debug 作为**全局属性**传给每个工程 —— csproj 里的默认值改不动它，
		Directory.Build.props 也挡不住。所以让"一次构建即可发布"成立的唯一可靠做法，是让 Debug 本身按发布质量编译。
		DEBUG 常量仍然保留：它只用于主工程给测试程序集开 InternalsVisibleTo（见 AssemblyInfo.cs）。
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<!--
		坑位：AppendTargetFrameworkToOutputPath=false 会【同时】去掉中间目录的 TFM 后缀，
		两个目标共用 obj\Release 会在并行编译时互相覆盖（报 "obj\Release\refint\xxx.dll 不存在"）。
		必须为每个 TFM 单独指定 IntermediateOutputPath。
	-->
	<!-- 1.6（已归档）：取消注释即恢复 net48 目标的输出目录与常量。
	<PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
		<IntermediateOutputPath>obj\$(Configuration)\net48\</IntermediateOutputPath>
		<OutputPath>..\..\1.6\Assemblies\</OutputPath>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_6</DefineConstants>
	</PropertyGroup>
	-->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<IntermediateOutputPath>obj\$(Configuration)\net10.0\</IntermediateOutputPath>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
		<DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
	</PropertyGroup>

	<!-- 1.7 引用游戏安装目录：可用 -p:RimWorldDir=… 或环境变量 RIMWORLD_DIR 覆盖 -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
		<RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</RimWorldDir>
	</PropertyGroup>

	<!-- 1.6（已归档）：Krafs 引用包（锁在 1.6.x，避免 * 浮动到别的大版本）。取消注释即恢复 net48 引用。
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Krafs.Rimworld.Ref">
			<Version>1.6.*</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	-->

	<!-- 1.7：直接引用游戏程序集；Unity 由 UnityStubs 提供，Waylith 是 UnityStubs 的实现层 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)Waylith.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Harmony 分 TFM 引用（运行时由游戏/依赖模组提供，不复制到输出） -->
	<!-- 1.6（已归档）：net48 用的 Harmony 2.4.x。取消注释即恢复。
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="Lib.Harmony">
			<Version>2.4.*</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Lib.Harmony">
			<Version>3.0.0-rc.2</Version>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>
	<!-- 可选 Mod（PipeSystem / VEF / VanillaPsycastsExpanded）不在此引用：
	     一旦引用，编译器就可能把它们的类型编进类型/闭包字段，未加载该 Mod 的玩家会在
	     启动期 TypeLoadException。这些 Mod 的类型一律按全名反射访问（见 DataUtility）。 -->

	<!-- 测试工程需要访问 internal 类型（FieldCodecs 登记表、StockGeneratorCodec 等）。
	     注意：不能用 <InternalsVisibleTo> item —— 上面 GenerateAssemblyInfo=false 会把它吃掉；
	     改为在 AssemblyInfo.cs 里手写特性（且仅 Debug）。 -->
</Project>
