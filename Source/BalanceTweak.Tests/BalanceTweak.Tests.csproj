<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 游戏安装目录：Source/_probe_tests 往上 4 层 -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..', '..'))</RimWorldDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Reflect.Field 走 Harmony 拿私有字段，测试进程里也要有它。
         （mod 本体把 Lib.Harmony 标了 ExcludeAssets=runtime，所以不会被复制过来） -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BalanceTweak\BalanceTweak.csproj" />
  </ItemGroup>

  <!-- 游戏程序集必须复制到测试输出，否则运行时找不到 Verse/Unity 类型 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
